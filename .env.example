# Backend API base URL
NEXT_PUBLIC_API_URL="http://localhost:5000/api"

# Demo account shown on the login page's "Try Demo Account" button.
# Must match DEMO_USER_EMAIL / the seeded password on the backend
# (see backend .env.example — DEMO_USER_EMAIL / DEMO_USER_PASSWORD_SEED).
NEXT_PUBLIC_DEMO_EMAIL="demo@codebox.com"
NEXT_PUBLIC_DEMO_PASSWORD="Demo@1234"
